{
  "name": "hyper-code-editor-v2",
  "version": "2.0.0-alpha",
  "description": "VS Code-like code editor for Windows desktop",
  "main": "dist/main/main.js",
  "homepage": "./",
  "private": true,
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "monaco-editor": "^0.44.0",
    "electron-squirrel-startup": "^1.1.0",
    "xterm": "^5.2.0",
    "xterm-addon-fit": "^0.7.0",
    "axios": "^1.4.0",
    "zustand": "^4.3.9",
    "react-icons": "^4.10.1",
    "classnames": "^2.3.2",
    "js-beautify": "^1.14.8",
    "prettier": "^3.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/node": "^20.3.1",
    "@types/electron": "^1.6.10",
    "typescript": "^5.1.3",
    "webpack": "^5.88.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^4.15.1",
    "@babel/core": "^7.22.5",
    "@babel/preset-env": "^7.22.5",
    "@babel/preset-react": "^7.22.5",
    "@babel/preset-typescript": "^7.22.5",
    "babel-loader": "^9.1.2",
    "ts-loader": "^9.4.3",
    "electron": "^25.2.0",
    "electron-builder": "^24.3.0",
    "concurrently": "^8.2.0",
    "wait-on": "^7.0.1",
    "eslint": "^8.43.0",
    "@typescript-eslint/eslint-plugin": "^5.59.11",
    "@typescript-eslint/parser": "^5.59.11"
  },
  "scripts": {
    "start": "concurrently \"npm run webpack-dev\" \"wait-on http://localhost:3000 && npm run electron-dev\"",
    "webpack-dev": "webpack serve --mode development --config webpack.config.js",
    "electron-dev": "electron .",
    "build": "webpack --mode production --config webpack.config.js",
    "electron-build": "npm run build && electron-builder",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "lint": "eslint src --ext .ts,.tsx",
    "type-check": "tsc --noEmit"
  },
  "build": {
    "appId": "com.tuccicybernation.hypercodeeditor",
    "productName": "Hyper Code Editor V2",
    "directories": {
      "buildResources": "assets",
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "certificateFile": null,
      "certificatePassword": null
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "author": "Tucci Cyber Nation & Kawooya Raymond",
  "license": "MIT"
}
